object frmDataViewer: TfrmDataViewer
  Left = 580
  Height = 560
  Top = 250
  Width = 660
  Caption = 'File Viewer'
  ClientHeight = 560
  ClientWidth = 660
  Color = clBtnFace
  Font.CharSet = ANSI_CHARSET
  Font.Color = clWindowText
  Font.Height = -11
  Font.Name = 'Tahoma'
  Position = poScreenCenter
  LCLVersion = '4.2.0.0'
  OnClose = FormClose
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  OnResize = FormResize
  object pnlOptions: TPanel
    Left = 0
    Height = 35
    Top = 0
    Width = 660
    Align = alTop
    BevelOuter = bvNone
    ClientHeight = 35
    ClientWidth = 660
    TabOrder = 0
    object radHex: TRadioButton
      AnchorSideLeft.Control = pnlOptions
      AnchorSideTop.Control = pnlOptions
      AnchorSideTop.Side = asrCenter
      Left = 8
      Height = 19
      Top = 8
      Width = 39
      BorderSpacing.Left = 8
      Caption = '&Hex'
      Checked = True
      TabOrder = 0
      TabStop = True
      OnChange = ModeChange
    end
    object radText: TRadioButton
      AnchorSideLeft.Control = radHex
      AnchorSideLeft.Side = asrBottom
      AnchorSideTop.Control = pnlOptions
      AnchorSideTop.Side = asrCenter
      Left = 57
      Height = 19
      Top = 8
      Width = 40
      BorderSpacing.Left = 10
      Caption = '&Text'
      TabOrder = 1
      OnChange = ModeChange
    end
    object radZ80: TRadioButton
      AnchorSideLeft.Control = radText
      AnchorSideLeft.Side = asrBottom
      AnchorSideTop.Control = pnlOptions
      AnchorSideTop.Side = asrCenter
      Left = 107
      Height = 19
      Top = 8
      Width = 39
      BorderSpacing.Left = 10
      Caption = '&Z80'
      TabOrder = 2
      OnChange = ModeChange
    end
    object lblAddress: TLabel
      AnchorSideLeft.Control = radZ80
      AnchorSideLeft.Side = asrBottom
      AnchorSideTop.Control = pnlOptions
      AnchorSideTop.Side = asrCenter
      Left = 170
      Height = 13
      Top = 11
      Width = 65
      BorderSpacing.Left = 24
      Caption = '&Start address'
      FocusControl = edtAddress
    end
    object edtAddress: TEdit
      AnchorSideLeft.Control = lblAddress
      AnchorSideLeft.Side = asrBottom
      AnchorSideTop.Control = pnlOptions
      AnchorSideTop.Side = asrCenter
      Left = 241
      Height = 21
      Top = 7
      Width = 48
      BorderSpacing.Left = 6
      CharCase = ecUppercase
      MaxLength = 6
      TabOrder = 3
      OnEditingDone = edtAddressEditingDone
    end
    object chkHeader: TCheckBox
      AnchorSideLeft.Control = edtAddress
      AnchorSideLeft.Side = asrBottom
      AnchorSideTop.Control = pnlOptions
      AnchorSideTop.Side = asrCenter
      Left = 305
      Height = 19
      Top = 8
      Width = 98
      BorderSpacing.Left = 16
      Caption = 'Include h&eader'
      TabOrder = 4
      OnChange = chkHeaderChange
    end
    object btnExecute: TButton
      AnchorSideTop.Control = pnlOptions
      AnchorSideTop.Side = asrCenter
      AnchorSideRight.Control = pnlOptions
      AnchorSideRight.Side = asrBottom
      Left = 492
      Height = 25
      Top = 5
      Width = 160
      Anchors = [akTop, akRight]
      AutoSize = True
      BorderSpacing.Right = 8
      Caption = '&Go to execute address'
      TabOrder = 5
      OnClick = btnExecuteClick
    end
  end
  object popView: TPopupMenu
    Left = 40
    Top = 80
    object itmFromHere: TMenuItem
      Caption = '&Disassemble from here'
      OnClick = itmFromHereClick
    end
    object itmSeparator: TMenuItem
      Caption = '-'
    end
    object itmCopy: TMenuItem
      Caption = '&Copy'
      OnClick = itmCopyClick
    end
    object itmSelectAll: TMenuItem
      Caption = 'Select &all'
      OnClick = itmSelectAllClick
    end
  end
end
